#!/usr/bin/env bash
# One-shot provisioning for a fresh Niteshift sandbox. Safe to re-run.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

DB_CONTAINER=umami-postgres
DB_IMAGE=postgres:15-alpine
DB_VOLUME=umami-db-data

# --- PostgreSQL -------------------------------------------------------------
# Docker bridge networking is unavailable in the sandbox, so the database runs
# with host networking and is reached at localhost:5432.
if [ -z "${DATABASE_URL:-}" ]; then
  if docker container inspect "$DB_CONTAINER" >/dev/null 2>&1; then
    docker start "$DB_CONTAINER" >/dev/null
  else
    docker run -d --name "$DB_CONTAINER" --network=host \
      -e POSTGRES_DB=umami \
      -e POSTGRES_USER=umami \
      -e POSTGRES_PASSWORD=umami \
      -v "$DB_VOLUME:/var/lib/postgresql/data" \
      "$DB_IMAGE" >/dev/null
  fi

  echo "Waiting for PostgreSQL..."
  for _ in $(seq 1 60); do
    if docker exec "$DB_CONTAINER" pg_isready -U umami -d umami >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done
  docker exec "$DB_CONTAINER" pg_isready -U umami -d umami
fi

# --- Environment ------------------------------------------------------------
# .env is gitignored; create it once so APP_SECRET stays stable across resumes.
if [ ! -f .env ]; then
  {
    echo "DATABASE_URL=${DATABASE_URL:-postgresql://umami:umami@localhost:5432/umami}"
    echo "APP_SECRET=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    # Allow the Niteshift preview panel to embed the app in an iframe.
    echo "ALLOWED_FRAME_URLS=https://niteshift.dev https://*.niteshift.dev"
  } > .env
fi

# --- Dependencies -----------------------------------------------------------
pnpm install --frozen-lockfile

# --- Prisma client + migrations --------------------------------------------
pnpm run build-db
# check-db verifies the connection and runs `prisma migrate deploy`, which also
# seeds the default admin/umami login on a fresh database.
pnpm run check-db

# --- Static assets ----------------------------------------------------------
pnpm run build-tracker
pnpm run build-recorder

# The GeoLite2 database is a 65MB download; only fetch it once.
if [ ! -f geo/GeoLite2-City.mmdb ]; then
  pnpm run build-geo
fi

# --- Demo data --------------------------------------------------------------
# Backfills three demo websites with a month of history, then tops up to the
# present. Existing sites are topped up rather than regenerated, so this is cheap
# on a warm sandbox. The seed-live service keeps it current from here.
pnpm run seed-data

echo "Setup complete. Log in at /login with admin / umami."
